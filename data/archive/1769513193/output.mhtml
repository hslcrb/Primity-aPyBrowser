.vertical-sequencer .glue-media { margin: 0px auto; max-width: 1126px; disp=
lay: flex; justify-content: center; padding: 0px 28px; order: -1; }

.vertical-sequencer > .glue-page { margin: 0px auto; }

.vertical-sequencer .glue-subheadline { color: var(--glue-grey-700); }

.vertical-sequencer .cta-container-desktop .glue-button, .vertical-sequence=
r .cta-container-mobile .glue-button { margin: 0px auto; justify-content: c=
enter; max-width: 599px; width: 100%; }

.vertical-sequencer .cta-container-desktop .glue-button:not(:first-of-type)=
, .vertical-sequencer .cta-container-mobile .glue-button:not(:first-of-type=
) { margin-top: 8px; }

